#!/usr/bin/env bash
# Launcher: runs the tool with its own Python environment, from anywhere (also through a symlink).
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
if [ ! -x "$here/.venv/bin/python" ]; then
  echo "Not installed yet. Run:  bash \"$here/installers/install.sh\"" >&2
  exit 1
fi
exec "$here/.venv/bin/python" "$here/main.py" "$@"
