# Replace each placeholder key with a real key before running the corresponding mode.
# Tip: on Windows write paths with forward slashes (C:/Videos/filler.mp4) or without quotes.
# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai / ollama / openai_compatible (can also be set with --llm)
LLM_MODEL=                    # optional: overrides the chosen provider's model (or --llm-model)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_NUM_CTX=16384
# openai_compatible: LM Studio, vLLM, llama.cpp server, OpenRouter, Groq, Together, ...
LLM_BASE_URL=                 # e.g. http://localhost:1234/v1
LLM_API_KEY=                  # optional for local servers
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
LOCAL_CROP_MODE=face          # face (track speaker) / center / split (two stacked panels)
# Split layout: top = source video, bottom = a facecam box OR any video you supply
LOCAL_FACECAM=                # x,y,w,h of the webcam in the source, e.g. 0,305,260,165
LOCAL_BOTTOM_VIDEO=           # path to a video for the bottom panel (overrides the facecam)
LOCAL_SPLIT_RATIO=0.6         # fraction of the height used by the top panel
